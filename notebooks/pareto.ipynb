    "axs[0].format(grid=False,xlabel=r'$R^2$',xlim=(0,0.8))\n",
    "if front:\n",
    "    mses    = [r['mse'] for r in front]\n",
    "    nparams = [r['nparams'] for r in front]\n",
    "    ymax    = max(r['nparams'] for r in results.values() if r['nparams'] is not None) * 3\n",
    "    extmse     = [999]+mses+[mses[-1]]\n",
