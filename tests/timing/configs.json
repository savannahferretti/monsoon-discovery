{
    "accumlabel":"end",
    "threshold":0.0001,
    "landfrac":0.5,
    "split":"test",
    "constantsigfigs":4,
    "variants":{
        "lead":{
            "statewindow":[0,0],
            "fluxwindow":[0,3],
            "targetwindow":[0,3],
            "description":"State at window start, fluxes and precipitation over the following 3 hours"},
        "concurrent":{
            "statewindow":[0,3],
            "fluxwindow":[0,3],
            "targetwindow":[0,3],
            "description":"State, fluxes, and precipitation all averaged over the same 3 hours"},
        "causal":{
            "statewindow":[-3,0],
            "fluxwindow":[-3,0],
            "targetwindow":[0,3],
            "description":"State and fluxes averaged over the preceding 3 hours"}},
    "nn":{
        "projectname":"Chapter-3-Timing",
        "runs":["nn_bl","nn_gauss"]},
    "sr":{
        "runs":["sr_bl","sr_atm","sr_sfc","sr_all","sr_all_k1"],
        "extraruns":{
            "sr_all_k1":{
                "fieldvars":["rh","thetae","thetaestar"],
                "localvars":["lf","shf","lhf"],
                "weightsfrom":"nn_gauss",
                "residualfrom":"sr_atm_eq",
                "complexityofvariables":{"rh":1,"thetae":1,"thetaestar":1}}},
        "optimizedeqs":["sr_bl_eq","sr_atm_eq","sr_sfc_eq","sr_all_eq","sr_all_pc_eq"],
        "variantequations":{
            "concurrent":{"sr_bl_eq":"sr_bl_eq","sr_atm_eq":"sr_atm_eq","sr_sfc_eq":"sr_sfc_eq","sr_all_eq":"sr_all_k1_eq"},
            "causal":{"sr_bl_eq":"sr_bl_exp_eq","sr_atm_eq":"sr_atm_sum_eq"}},
        "inits":{
            "causal":{
                "sr_bl_exp_eq":{"c17":2.338,"c18":0.6629},
                "sr_atm_sum_eq":{"c19":0.7665}},
            "concurrent":{
                "sr_all_eq":{"c9":5.06,"c10":0.764},
                "sr_all_k1_eq":{"c14":0.654,"c15":7.50,"c16":0.753}}},
        "extraeqs":{
            "sr_bl_exp_eq":{
                "runfrom":"sr_bl",
                "refcomplexity":7,
                "form":"exp(c17*(bl-c18))",
                "color":"#F2C85E",
                "description":"SR-BL"},
            "sr_atm_sum_eq":{
                "runfrom":"sr_atm",
                "refcomplexity":14,
                "form":"cube(rh)+cube(c19*thetae-thetaestar)",
                "seeds":[42,102],
                "color":"#FB992F",
                "description":"SR-ATM"},
            "sr_all_k1_eq":{
                "runfrom":"sr_all_k1",
                "refcomplexity":16,
                "form":"sr_atm_eq+c14*(thetae+c15*shf)*cube(c16-lf)",
                "seeds":[72],
                "color":"#B91B23",
                "description":"SR-ALL"}}}
}
