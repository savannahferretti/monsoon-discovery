{
    "filepaths":{
        "raw":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/raw",
        "interim":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/interim",
        "splits":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/splits",
        "predictions":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/predictions",
        "features":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/features",
        "weights":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/data/weights",
        "models":"/global/cfs/cdirs/m4334/sferrett/monsoon-discovery/models"},
    "metadata": {
        "author":"Savannah L. Ferretti",
        "email":"savannah.ferretti@uci.edu"},
    "domain":{
        "latrange":[5.0,25.0],
        "lonrange":[60.0,90.0],
        "levrange":[500.0,1000.0],
        "years":[2000,2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015, 2016,2017,2018,2019,2020],
        "months":[6,7,8],
        "target":"tp"},
    "splits":{
        "trainyears":[2000,2014],
        "validyears":[2015,2017],
        "testyears":[2018,2020]},
    "experiments":{
        "pod":{
            "bins":{
                "min":-0.6,
                "max":0.1,
                "width":0.0025,
                "minsample":50},
            "fit": {
                "ymin":5.0,
                "ymax":15.0},
            "runs": {
                "pod_bl":{
                    "inputvar":"bl",
                    "description":"POD-BL",
                    "color":"gray"}}},
        "nn":{
            "projectname": "Chapter-3-Experiments",
            "seeds":[42,72,102],
            "workers":8,
            "epochs":20,
            "batchsize":500,
            "learningrate":0.0005,
            "patience":4,
            "criterion":"MSELoss",
            "runs": {
                "nn_bl":{
                    "kind":"baseline",
                    "fieldvars":["bl"],
                    "localvars":[],
                    "color":"#a7def7",
                    "description":"NN-BL"},
                "nn_full":{
                    "kind":"baseline",
                    "fieldvars":["rh", "thetae","thetaestar"],
                    "localvars":["lf","shf","lhf"],
                    "color":"#1B2C61",
                    "description":"NN-FULL"},
                "nn_nonparam":{
                    "kind":"nonparametric",
                    "fieldvars":["rh","thetae","thetaestar"],
                    "localvars":["lf","shf","lhf"],
                    "color":"#539ed4",
                    "description":"NN-NONPARAM"},
                "nn_gauss":{
                    "kind":"parametric",
                    "kernel":"gaussian",
                    "fieldvars":["rh","thetae","thetaestar"],
                    "localvars":["lf","shf","lhf"],
                    "color":"#2355a1",
                    "description":"NN-GAUSS"}}},
        "sr":{
            "seeds":[42,72,102],
            "subsetfrac":0.025,
            "searchparams":{
                "iterations":500,
                "populations":25,
                "populationsize":150,
                "maxsize":25,
                "maxdepth":10,
                "batchsize":500,
                "cyclesperiteration":50,
                "weightoptimize":0.25,
                "parsimony":0.0025},
            "operators":{
                "binary":["+","-","*","/","^","min","max"],
                "unary":["neg","abs","square","cube","exp"],
                "complexity":{"+":1,"-":1,"*":1,"/":2,"^":2,"min":2,"max":2,"neg":1,"abs":2,"square":2,"cube":2,"exp":2}},
            "complexity":{
                "ofvariables":{"bl":1,"rh":2,"thetae":2,"thetaestar":2,"lf":1,"shf":2,"lhf":2},
                "ofconstants":1},
            "constraints":{
                "^":[-10,10]},
            "nestedconstraints":{
                "/":{"/":0},
                "^":{"^":0},
                "min":{"min":0,"max":0},
                "max":{"min":0,"max":0},
                "neg":{"neg":0,"abs":0},
                "abs":{"neg":0,"abs":0,"exp":0},
                "square":{"^":0},
                "cube":{"^":0,"cube":0},
                "exp":{"^":0,"abs":0,"square":0,"cube":0,"exp":0}},
            "runs": {
                "sr_gauss_bl":{
                    "fieldvars":["bl"],
                    "localvars":[],
                    "searchparams":{"maxsize":10}},
                "sr_gauss_atm":{
                    "fieldvars":["rh","thetae","thetaestar"],
                    "localvars":[],
                    "weightsfrom":"nn_gauss"},
                "sr_gauss_sfc":{
                    "fieldvars":[],
                    "localvars":["lf","lhf","shf"],
                    "weightsfrom":"nn_gauss",
                    "baselinefrom":"sr_atm"},
                "sr_gauss_sfc_ocean":{
                    "fieldvars":[],
                    "localvars":["shf","lhf"],
                    "weightsfrom":"nn_gauss",
                    "baselinefrom":"sr_atm",
                    "domainmask":{"var":"lf","op":"<","val":0.5}},
                "sr_gauss_sfc_land":{
                    "fieldvars":[],
                    "localvars":["shf","lhf"],
                    "weightsfrom":"nn_gauss",
                    "baselinefrom":"sr_atm",
                    "domainmask":{"var":"lf","op":">=","val":0.5}},
                "sr_gauss_all":{
                    "fieldvars":["rh","thetae","thetaestar"],
                    "localvars":[],
                    "weightsfrom":"nn_gauss",
                    "baselinefrom":"sr_sfc"}},
            "optimizedeqs":{
                "sr_bl":{
                    "runfrom":"sr_gauss_bl",
                    "refcomplexity":7,
                    "form":"cube(bl+a)+b",
                    "color":"#F2C75E",
                    "description":"SR-BL"},
                "sr_atm":{
                    "runfrom":"sr_gauss_atm",
                    "refcomplexity":17,
                    "form":"a*cube(max(rh,thetae-b*thetaestar-c))",   
                    "color":"#FB992E",
                    "description":"SR-ATM"},
                "sr_sfc":{
                    "runfrom":"sr_gauss_sfc",
                    "refcomplexity":13,
                    "form":"sr_atm+(shf+a)*cube(b-lf)",
                    "color":"#C44E52",
                    "description":"SR-SFC"},
                "sr_sfc_pw":{
                    "runfrom":"sr_gauss_sfc",
                    "refcomplexity":null,
                    "form":"(1-lf)*((sr_atm+a)*min(b,shf+c)+d)+lf*(sr_atm+e*lhf-f*shf)",
                    "init":{"a":0.73,"b":1.45,"c":1.0,"d":-0.58,"e":0.40,"f":0.59},
                    "color":"#9B2948",
                    "description":"SR-SFC-PW"},
                "sr_all":{
                    "runfrom":"sr_gauss_all",
                    "refcomplexity":14,
                    "form":"a*(rh+b)*sr_sfc+c*thetae",
                    "init":{"a":0.18,"b":4.3,"c":0.11},
                    "color":"#577590",
                    "description":"SR-ALL"}
            }
        }
    }
}